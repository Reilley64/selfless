{
  "name": "@selfless/ui",
  "private": true,
  "license": "MIT OR Apache-2.0",
  "main": "src/index.ts",
  "scripts": {
    "generate": "bun run generate:telemetry && bun run generate:theme",
    "generate:telemetry": "weaver registry generate --quiet --registry ../../telemetry/registry --templates ../../telemetry/templates ts src/telemetry",
    "generate:theme": "style-dictionary build --config style-dictionary.config.mjs",
    "typecheck": "tsc --noEmit",
    "test": "jest"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/core": "^3.0.0",
    "@opentelemetry/exporter-logs-otlp-proto": "^0.300.0",
    "@opentelemetry/exporter-metrics-otlp-proto": "^0.300.0",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.300.0",
    "@opentelemetry/resources": "^3.0.0",
    "@opentelemetry/sdk-logs": "^3.0.0",
    "@opentelemetry/sdk-metrics": "^3.0.0",
    "@opentelemetry/sdk-trace": "^3.0.0",
    "@opentelemetry/semantic-conventions": "^1.44.0",
    "@selfless/api-client": "workspace:*",
    "react-native-css": "catalog:"
  },
  "devDependencies": {
    "@tanstack/react-query": "^5.105.0",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^30.0.0",
    "expo": "catalog:",
    "jest": "^30.5.2",
    "jest-expo": "~58.0.13",
    "react": "catalog:",
    "react-native": "catalog:",
    "style-dictionary": "^5.7.1",
    "test-renderer": "^1.3.1"
  },
  "peerDependencies": {
    "react": "catalog:",
    "react-native": "catalog:"
  },
  "jest": {
    "preset": "jest-expo",
    "resolver": "<rootDir>/jest.resolver.js"
  }
}
